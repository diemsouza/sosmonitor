{
  "server_name": "MY-SERVER",
  "check_interval_minutes": 1,
  "disk_path": "/",
  "send_every_check": true,
  "sustain_checks": 1,
  "thresholds": {
    "cpu": {
      "80": "{metric} at {value}%",
      "95": "{metric} at {value}% (CRITICAL)"
    },
    "memory": {
      "80": "{metric} at {value}%",
      "95": "{metric} at {value}% (CRITICAL)"
    },
    "disk": {
      "95": "{metric} at {value}%",
      "98": "{metric} at {value}% (ALMOST FULL)"
    }
  },
  "recovery_message": "{metric} at {value}% (BACK TO NORMAL)",
  "reboot_message": "{server} restarted (up for {value})",
  "top_processes": {
    "enabled": true,
    "count": 3
  },
  "webhook": {
    "enabled": false,
    "url": "",
    "token": "",
    "token_header": "X-Monitor-Token"
  },
  "email": {
    "enabled": false,
    "smtp_host": "",
    "smtp_port": 587,
    "username": "",
    "password": "",
    "from": "",
    "to": []
  }
}
